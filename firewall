# WINDOWS SECURITY (AGGREGATOR)
# -----------------------------
def collect_windows_security():
    """
    Collect:
    - Firewall status + rule risks (implemented)
    - (Placeholders) Defender status, SMBv1, RDP, Users, Password policy, Installed patches
    """
    security = {
        "timestamp_utc": datetime.utcnow().isoformat() + "Z",
        "firewall": scan_windows_firewall(),

        # placeholders for future modules
        "defender": {"status": "not_implemented"},
        "smbv1": {"status": "not_implemented"},
        "rdp": {"status": "not_implemented"},
        "users": {"status": "not_implemented"},
        "password_policy": {"status": "not_implemented"},
        "installed_patches": {"status": "not_implemented"},
    }
    return security


# -----------------------------
# OPTIONAL: SAVE REPORT
# -----------------------------
def save_report_json(report: dict, filename: str):
    with open(filename, "w", encoding="utf-8") as f:
        json.dump(report, f, indent=2)


# -----------------------------
# MAIN
# -----------------------------
def main():
    os_info = collect_os_information()
    security = collect_windows_security()

    full_report = {
        "os_information": os_info,
        "windows_security": security,
    }

    # Print only firewall user-friendly output (as you asked)
    print_firewall_results_user_friendly(security["firewall"])

    # Optional: save report file
    out_name = f"windows_security_report_{datetime.utcnow().strftime('%Y%m%d_%H%M%S')}_UTC.json"
    save_report_json(full_report, out_name)
    print(f"📄 Saved JSON report: {out_name}")


if __name__ == "__main__":
    main()
